# Copy this file to .env and fill in your keys. .env is gitignored — never commit it.
# No quotes, no spaces around the '='.

# Saudi dialect rewrite via Claude — read in backend/pipeline.py
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hugging Face model downloads (Whisper, MarianMT, XTTSv2) via huggingface_hub
# Get one at https://huggingface.co/settings/tokens (read access is enough)
HF_TOKEN=
